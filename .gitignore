# Root .gitignore for ProofPocket monorepo

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local

# Environment variables in any project folder
**/.env
**/.env.*
!**/.env.example

# Dependencies
node_modules/

# Build output
dist/
build/

# Logs & Backups
*.log
npm-debug.log*
backups/
**/backups/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.sw?

backend/uploads/